{
  "_schema": "BadUSB-Solution Logs",
  "_description": "애플리케이션 로그 (Core/logger.h/cpp - 최대 500개, FIFO)",
  "max_entries": 0,
  "entries": [
    {
      "index": 0,
      "message": "",
      "category": "",
      "timestamp": ""
    }
  ],
  "_log_prefix_to_category": {
    "[A]": "system — 애플리케이션 시작",
    "[Init]": "init — HID 알림 등록 성공/실패",
    "[Auto]": "detect — 자동 감지 (도착/제거/중복무시)",
    "[UI]": "ui — 승인 UI 표시/저장/취소",
    "[T]": "policy — 정책 반영 (Whitelist/Blacklist 추가)",
    "[Approval]": "approval — 승인 후보 장치 목록",
    "[Hook]": "hook — 키보드 후킹 설치/제거",
    "[Test]": "test — 테스트 결과 (Allow/Deny)"
  },
  "_categories": [
    "system",
    "init",
    "ui",
    "policy",
    "detect",
    "approval",
    "hook",
    "test",
    "auto"
  ],
  "_input_source": {
    "max_entries": "app_config.json의 max_log_entries 값 (기본 500)",
    "entries[].index": "g_logs 벡터 내 인덱스 (0부터 시작, FIFO 시 앞에서부터 삭제)",
    "entries[].message": "Logger::Add(const std::wstring& s) → 코드 전역에서 호출",
    "entries[].category": "message 접두사([A], [Init], [Auto] 등)로 결정",
    "entries[].timestamp": "Logger::Add() 호출 시점 타임스탬프 (ISO 8601)",
    "_caller_locations": {
      "[A] Start": "main.cpp → InitInstance() 시작",
      "[Init] HID notifications": "hid_monitor.cpp → RegisterNotifications()",
      "[Auto] HID arrival/removal": "hid_monitor.cpp → OnDeviceChange()",
      "[Auto] Duplicate arrival ignored": "hid_monitor.cpp → g_seenDevicePaths 중복 시",
      "[UI] Showing approval list": "hid_approval_flow.cpp → RunApprovalDialog() 진입",
      "[UI] Saved/Canceled": "hid_approval_flow.cpp → RunApprovalDialog() 결과",
      "[T] Added to Whitelist/Blacklist": "hid_approval_flow.cpp → Policy::AddWhitelist/AddBlacklist",
      "[Approval] Candidate": "hid_approval_flow.cpp → ApproveDevicesFromPaths() 루프",
      "[Hook] Keyboard hook installed/removed": "keyboard_hook.cpp → Install()/Uninstall()",
      "[Test] User: Allow/Deny": "main.cpp → BufferViewUI::Show() 결과"
    }
  }
}
