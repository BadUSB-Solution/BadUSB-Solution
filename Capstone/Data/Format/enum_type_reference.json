  "enums": {
    "BadUsbEventType": {
      "_source": "Hook/badusb.h",
      "None": 0,
      "DeviceConnected": 1
    },
    "BadUsbDecision": {
      "_source": "Hook/badusb.h",
      "Hold": 0,
      "Allow": 1,
      "Block": 2
    },
