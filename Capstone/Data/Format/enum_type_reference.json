      "_source": "USB HID Specification",
      "class": 3,
      "subclass_boot": 1,
      "protocol_keyboard": 1,
      "protocol_mouse": 2
    }
  },

  "struct_mappings": {
    "UsbItem": {
      "_source": "Core/usb_item.h",
      "_json_file": "devices.json",
      "fields": {
        "vid": "uint16_t → hex string (0x0000~0xFFFF)",
        "pid": "uint16_t → hex string (0x0000~0xFFFF)",
        "fingerprint": "uint64_t → number",
        "devicePath": "std::wstring → string",
        "name": "std::wstring → string",
        "allow": "bool → boolean"
      }
    },
    "BadUsbDeviceEvent": {
      "_source": "Hook/badusb.h",
      "_json_file": "device_events.json",
      "fields": {
        "type": "BadUsbEventType(uint32_t) → string/number",
        "deviceInstanceIdHash": "uint64_t → number",
        "vid": "uint16_t → hex string",
        "pid": "uint16_t → hex string",
        "interfaceClass": "uint32_t → number",
        "interfaceSubClass": "uint32_t → number",
        "interfaceProtocol": "uint32_t → number"
      }
    },
    "BadUsbDecisionRequest": {
      "_source": "Hook/badusb.h",
      "_json_file": "device_decisions.json",
      "fields": {
        "deviceInstanceIdHash": "uint64_t → number",
        "decision": "BadUsbDecision(uint32_t) → string/number"
      }
    },
    "KeyRecord": {
      "_source": "Hook/keyboard_hook.h",
      "_json_file": "keyboard_hook.json",
      "fields": {
        "vkCode": "DWORD → number",
        "scanCode": "DWORD → number",
        "flags": "DWORD → number (bit 7 = key up)",
        "time": "DWORD → number (milliseconds)"
      }
    }
  },

