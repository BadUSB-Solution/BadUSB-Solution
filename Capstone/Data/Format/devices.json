    "fingerprint": "uint64_t → number (FNV-1a 64bit 해시)",
    "device_path": "std::wstring → string (HID 인터페이스 경로)",
    "name": "std::wstring → string (장치 표시명, 빈 문자열 가능)",
    "allow": "bool → boolean (true=Whitelist, false=Blacklist)"
  },
  "_input_source": {
    "vid": "HidFingerprint::ExtractVidPid() → devicePath에서 VID_ 토큰 파싱",
    "pid": "HidFingerprint::ExtractVidPid() → devicePath에서 PID_ 토큰 파싱",
    "fingerprint": "HidFingerprint::BuildFingerprint(hasVidPid, vid, pid, identityKey)",
    "device_path": "HidInitialScan::EnumeratePresentHidDevicePaths() 또는 WM_DEVICECHANGE → DBT_DEVICEARRIVAL",
    "name": "ResolveDeviceMetadataFromPath() → HidD_GetProductString 등 다단계 탐색",
    "allow": "ApprovalUI::ShowUsbListDialog() → 사용자 체크박스 입력"
  }
